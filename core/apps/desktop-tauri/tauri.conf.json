{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multiversa Core",
  "version": "0.1.0",
  "identifier": "com.multiversa.core",
  "build": {
    "frontendDist": "../../apps/studio/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @multiversa/studio dev",
    "beforeBuildCommand": "pnpm --filter @multiversa/studio build"
  },
  "app": {
    "windows": [
      {
        "title": "Multiversa Core",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}