# ============================================================
# Multiversa Lab — landing/.env.example
# Copy to .env and fill in real values. NEVER commit .env to git.
# .env and .env.* are gitignored (see .gitignore).
# ============================================================

# KB support chatbot widget (multiversa-kb-chatbot Worker). Leave unset
# to keep the widget disabled — the +layout.svelte mount is a no-op
# without this. Security policy only permits the audited custom domain.
PUBLIC_KB_CHAT_ENDPOINT=

# ─── Private (server-only, never reaches the client) ────────
# Admin / service-role key — full access. Use only inside +server.ts files.
# Keep gitignored. Rotate if exposed.
INSFORGE_API_KEY=ik_paste_your_admin_key_here
INSFORGE_API_BASE_URL=https://uzyhdq3q.us-east.insforge.app
# Optional comma-separated notification destinations. If omitted, the
# current operational inboxes remain in use.
LAB_LEAD_INBOXES=
